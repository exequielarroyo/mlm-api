### Current user (requires bearer token from /login)
GET {{mlm_HostAddress}}/me
Authorization: Bearer {{token}}

###
POST {{mlm_HostAddress}}/admin/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Starter Product",
  "imageUrl": "https://example.com/product.jpg",
  "price": 500,
  "discountPercent": 0
}

###
GET {{mlm_HostAddress}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

###
GET {{mlm_HostAddress}}/admin/orders
Authorization: Bearer {{token}}
Content-Type: application/json

###
@orderId = 7d44b69a-5af5-430c-9709-4e12934dcb9b

###
POST {{mlm_HostAddress}}/admin/orders/{{orderId}}/complete
Authorization: Bearer {{token}}

###
POST {{mlm_HostAddress}}/admin/payouts
Authorization: Bearer {{token}}